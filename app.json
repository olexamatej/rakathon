{
  "expo": {
    "name": "PillGaze",
    "slug": "pillgaze",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7F5",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "name": "PillGaze"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "PillGaze potřebuje vybranou fotografii seznamu nebo balení léku.",
          "cameraPermission": "PillGaze potřebuje fotoaparát pro pořízení fotografie léků.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}
