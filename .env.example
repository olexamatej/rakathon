# Server-only OpenRouter credentials for the engine's POST /transcribe endpoint.
# Never use browser-visible variables for these values. Gemini/Google keys are not used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash
# Optional OpenRouter-compatible base URL (without /chat/completions).
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# One provider call deadline in seconds (default 120).
# OPENROUTER_TIMEOUT_SECONDS=120
# The Rust engine automatically loads this file (existing environment values win).
# Default listener: 127.0.0.1:6767.
# BIND_ADDR=127.0.0.1:6767
# SÚKL catalogue and jobs database defaults work from the repo root or engine directory.
# Explicit relative paths resolve from the directory where you run the engine.
# Patient web server: upstream for /api/transcribe and /api/interaction-*. The transcribe
# URL wins when set, otherwise the interaction URL, otherwise production.
TRANSCRIBE_API_URL=http://127.0.0.1:6767
# INTERACTION_API_URL=http://127.0.0.1:3000

# Local UI -> deployed backend; npm run web:remote uses this origin by default.
# Setting this also enables remote proxying for npm start. No /api suffix or credentials.
# All /api routes use this backend, overriding the engine URLs above.
# WARNING: uploads/admin deletion affect the deployed database. Synthetic data only.
# WEB_BACKEND_URL=https://rakathon.denishromada.com
# PORT=8081
# Remote proxy defaults to loopback. Set HOST only to intentionally expose it to your LAN.
# HOST=127.0.0.1
