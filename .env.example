# Server-only credentials for the interaction engine's POST /transcribe endpoint.
# Never use browser-visible variables for these values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: Gemini-compatible endpoint override, e.g. a local CLIProxyAPI proxy backed
# by an Antigravity OAuth login. When set, large photos are sent inline (no Google Files API).
# GEMINI_API_BASE=http://127.0.0.1:8317/v1beta
# One provider call deadline in seconds (default 120).
# GEMINI_TIMEOUT_SECONDS=120
# SÚKL catalogue used for photo name spelling; the npm run engine script defaults to
# data/sukl/medications.json (the engine itself defaults to ../data/sukl/medications.json).
# SUKL_CATALOGUE_PATH=data/sukl/medications.json
# Patient web server: upstream for /api/transcribe and /api/interaction-*. The transcribe
# URL wins when set, otherwise the interaction URL, otherwise production.
# TRANSCRIBE_API_URL=http://127.0.0.1:3000
# INTERACTION_API_URL=http://127.0.0.1:3000

# Local UI -> deployed backend; npm run web:remote uses this origin by default.
# Setting this also enables remote proxying for npm start. No /api suffix or credentials.
# All /api routes use this backend, overriding the engine URLs above.
# WARNING: uploads/admin deletion affect the deployed database. Synthetic data only.
# WEB_BACKEND_URL=https://rakathon.denishromada.com
# PORT=8081
# Remote proxy defaults to loopback. Set HOST only to intentionally expose it to your LAN.
# HOST=127.0.0.1
