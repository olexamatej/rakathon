# Normalize source files consistently across Linux, macOS, and Windows.
* text=auto
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Dataset fingerprints depend on the exact CSV bytes: never normalize them.
assets/*.csv -text

# Binary reference material and images.
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
