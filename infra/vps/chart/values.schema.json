{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["hostname", "release", "revision", "webImage", "apiImage", "nodePort"],
  "properties": {
    "hostname": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+[a-z0-9]$"},
    "release": {"type": "string", "pattern": "^(development|[a-f0-9]{40}-[0-9]+-[0-9]+)$"},
    "revision": {"type": "string", "pattern": "^(development|[a-f0-9]{40})$"},
    "webImage": {"const": "rakathon-web"},
    "apiImage": {"const": "rakathon-api"},
    "nodePort": {"const": 30080}
  }
}
