root = true

[*.{py,js,css,html,json,md,toml,yml,yaml,txt,sh}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,toml,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces can be an intentional Markdown line break.
trim_trailing_whitespace = false
