# Copy to .env for local development and replace this placeholder.
TRANSFER_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
BIND_ADDRESS=127.0.0.1:3000
PILLGAZE_DB_PATH=services/transfer-api/data/transfers.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
