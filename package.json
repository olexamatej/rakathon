    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.30",
    "expo-clipboard": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
